# Public site URL (dùng cho SEO + canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 / S3-compatible storage (tùy chọn — ảnh remote trong next/image)
S3_PUBLIC_BASE_URL=https://media.example.com

# Cache invalidation webhook
REVALIDATION_SECRET=replace-with-long-random-secret

# Google Analytics (tùy chọn)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
