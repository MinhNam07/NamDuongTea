# PostgreSQL connection (khớp với docker-compose.yml)
DATABASE_URI=postgres://namduong:namduong@localhost:5432/namduongtea

# Payload secret (sinh chuỗi ngẫu nhiên 32+ ký tự)
PAYLOAD_SECRET=replace-with-long-random-string

# Public site URL (dùng cho SEO + canonical + preview)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload public URL (mặc định = site URL)
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Cloudflare R2 / S3-compatible storage (production — bỏ trống để dùng local public/media)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nam-duong-tea-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://media.example.com

# Cache invalidation webhook
REVALIDATION_SECRET=replace-with-long-random-secret

# Content source: payload (default) | legacy (rollback)
CONTENT_SOURCE=payload

# Migration
MIGRATION_DRY_RUN=false

# Google Analytics (tùy chọn — bỏ trống nếu chưa có)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email thông báo lead qua Resend (tùy chọn — bỏ trống nếu chưa có)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=thuynamduong64@gmail.com
EMAIL_FROM=Nam Dương Tea <noreply@yourdomain.com>

# Dev seed token (chỉ development)
SEED_TOKEN=dev

# 3 tài khoản admin cố định (chạy: pnpm seed:admins)
ADMIN_USER_1_EMAIL=admin1@example.com
ADMIN_USER_1_PASSWORD=replace-with-strong-password
ADMIN_USER_1_NAME=Quản trị viên 1
ADMIN_USER_2_EMAIL=admin2@example.com
ADMIN_USER_2_PASSWORD=replace-with-strong-password
ADMIN_USER_2_NAME=Quản trị viên 2
ADMIN_USER_3_EMAIL=admin3@example.com
ADMIN_USER_3_PASSWORD=replace-with-strong-password
ADMIN_USER_3_NAME=Quản trị viên 3
